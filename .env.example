
# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Grok
XAI_API_KEY=your_xai_api_key

# Stripe (verify latest API version at https://stripe.com/docs/upgrades)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLAN_MONTHLY=
STRIPE_PRICE_PLAN_ANNUAL=
STRIPE_PRICE_ADVISOR_MONTHLY=
STRIPE_PRICE_ADVISOR_ANNUAL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Market Data
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=your_finnhub_api_key
FMP_API_KEY=your_fmp_api_key

# Stock Picker — X (Twitter) OAuth 2.0 app (optional; enables "link your X account")
# Callback URL must be: ${NEXT_PUBLIC_APP_URL}/api/picks/twitter/callback
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=

# Stock Picker — congress trade feeds (optional overrides; free defaults built in)
SENATE_TRADES_URL=
HOUSE_TRADES_URL=

# Signals export for external consumers (e.g. HELM trading bot)
# Generate with: openssl rand -hex 32
EXPORT_API_TOKEN=
# Dedicated token for the external research consumer (revocable independently)
RESEARCH_EXPORT_TOKEN=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@mosaicfinance.ai
CIM_REVIEWER_EMAIL=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cron
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (Postgres + Auth + Storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-your_key

# --- xAI Grok (web + X search for market context) ---
XAI_API_KEY=your_xai_api_key

# --- Stripe (CAD; use test keys locally) ---
# Verify latest API version at https://stripe.com/docs/upgrades
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_secret
STRIPE_PRICE_PLAN_MONTHLY=price_xxx
STRIPE_PRICE_PLAN_ANNUAL=price_xxx
STRIPE_PRICE_ADVISOR_MONTHLY=price_xxx
STRIPE_PRICE_ADVISOR_ANNUAL=price_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key

# --- Market data providers ---
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
FINNHUB_API_KEY=your_finnhub_api_key
FMP_API_KEY=your_fmp_api_key

# --- Stock picker: X (Twitter) OAuth 2.0 (optional) ---
# Callback URL: ${NEXT_PUBLIC_APP_URL}/api/picks/twitter/callback
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=

# --- Stock picker: congress trade feeds (optional overrides) ---
SENATE_TRADES_URL=
HOUSE_TRADES_URL=

# --- Export API tokens (machine consumers; generate with openssl rand -hex 32) ---
EXPORT_API_TOKEN=
RESEARCH_EXPORT_TOKEN=

# --- Email (Resend) ---
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=hello@example.com
CIM_REVIEWER_EMAIL=reviewer@example.com

# --- Analytics / error tracking (optional for local) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Upstash Redis (cache + rate limits) ---
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# --- Cron auth (Vercel Cron → /api/cron/*) ---
CRON_SECRET=generate_with_openssl_rand_hex_32

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

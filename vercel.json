{
  "regions": ["yul1"],
  "functions": {
    "src/app/api/plan/generate/**/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/pdf/**/route.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "src/app/api/market/commentary/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/newsletter/generate/route.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/newsletter/generate",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/cron/picks-scan",
      "schedule": "*/30 13-21 * * 1-5"
    },
    {
      "path": "/api/cron/picks-scan?enrich=1",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/picks-congress",
      "schedule": "30 11 * * *"
    }
  ]
}
